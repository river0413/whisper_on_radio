# 复制为 .env 并填写（.env 不要提交/分享）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
# 直接翻译模式关闭推理：推理会占满输出额度，导致回复为空
# （校对模式由 PROOFREAD_THINKING 单独控制，默认 auto）
DEEPSEEK_THINKING=disabled
# 每段校对输出的字幕条数与输出上限
PROOFREAD_LINES=200
PROOFREAD_MAX_TOKENS=384000
# 校对启用推理（推理 token 计入上面的输出上限）
PROOFREAD_THINKING=auto
HY_MT_MODEL=hf.co/tencent/Hy-MT2-7B-GGUF:Q4_K_M
OLLAMA_HOST_URL=http://127.0.0.1:11434
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
